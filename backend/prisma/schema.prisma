generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  cartValue         Float
  decision          String
  riskProbability   Float
  shapExplanations  Json
  userData          Json
}
